# Postgres-Verbindung
DATABASE_URL=postgres://objektakte:objektakte@localhost:5432/objektakte
# Bearer-Token für die API (wird später durch OIDC ergänzt)
API_TOKEN=change-me
PORT=3000
# Intervall des Webhook-Versands in Millisekunden
WEBHOOK_INTERVAL_MS=5000
# Dateiablage: local oder nextcloud
STORAGE_BACKEND=local
STORAGE_DIR=./data/files
STORAGE_BASE_PATH=/objektakte
# NEXTCLOUD_URL=https://cloud.example.org/remote.php/dav/files/benutzer
# NEXTCLOUD_USER=benutzer
# NEXTCLOUD_PASSWORD=app-passwort
# PDF-Erzeugung (Gotenberg)
# GOTENBERG_URL=http://gotenberg:3000
# Transkription (OpenAI-kompatibler Whisper-Server)
# WHISPER_URL=http://whisper:8000
# WHISPER_MODEL=Systran/faster-whisper-large-v3
WORKER_INTERVAL_MS=10000
